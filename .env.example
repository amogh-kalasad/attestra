# Attestra environment template. Copy to `.env` or export in the shell.
# Changing most values requires restarting the API process and any workers.
# Placeholders only — never commit real passwords, API keys, or production secrets.

# =============================================================================
# Application / APP_ENV
# =============================================================================
# Deployment environment. Known: local, test, development, staging, production.
# Bypass flags only activate when APP_ENV is local, test, or development.
# Unset APP_ENV is allowed when both bypass flags are false (checks stay mandatory).
APP_ENV=local

# ATTESTRA_DATA_DIR=./data
# ATTESTRA_PUBLIC_URL=http://127.0.0.1:8000
# ATTESTRA_EVIDENCE_MAX_BYTES=20971520

# =============================================================================
# MongoDB
# =============================================================================
# Host venv / local mongod (replica set required for multi-document transactions):
# Host CLI against Compose Mongo needs directConnection=true (RS advertises host "mongo").
ATTESTRA_MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
ATTESTRA_MONGODB_DB=attestra
# Optional: separate URI for tests (throwaway DBs must be named attestra_test_*)
ATTESTRA_TEST_MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
#
# Docker Compose sets the in-network URI for API/worker services, e.g.:
#   ATTESTRA_MONGODB_URI=mongodb://mongo:27017/?replicaSet=rs0
# With auth enabled (preferred for shared/Compose setups):
#   mongodb://attestra_app:<password>@mongo:27017/?replicaSet=rs0&authSource=admin
# Host-side tools still use 127.0.0.1 (or localhost) against the published port.
# Securing local MongoDB (users, auth, keyFile, bind 127.0.0.1):
# docs/mongodb_migration/SECURE_LOCAL_MONGO.md

# =============================================================================
# Persistence / storage / GridFS
# =============================================================================
# Runtime is MongoDB only. ATTESTRA_PERSISTENCE is retained for older deploy env files.
# ATTESTRA_PERSISTENCE=mongo
# Artifact store: mongo (GridFS) | local (files in ATTESTRA_DATA_DIR) | s3.
# Defaults to mongo.
# ATTESTRA_STORAGE=mongo
# GridFS bucket for durable artifacts (reports, evidence, raw tool output).
ATTESTRA_MONGODB_GRIDFS_BUCKET=attestra_artifacts
# ATTESTRA_MONGODB_TLS=false
# ATTESTRA_MONGODB_TLS_CA_FILE=
# ATTESTRA_MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# ATTESTRA_MONGODB_CONNECT_TIMEOUT_MS=5000
# ATTESTRA_MONGODB_SOCKET_TIMEOUT_MS=30000
# ATTESTRA_MONGODB_MAX_POOL_SIZE=50
# Optional S3 when ATTESTRA_STORAGE=s3 (requires optional .[s3]):
# ATTESTRA_S3_BUCKET=
# ATTESTRA_S3_ENDPOINT=
# ATTESTRA_S3_OBJECT_LOCK=false

# =============================================================================
# Auth secrets (placeholders — replace before any shared environment)
# =============================================================================
# ATTESTRA_SESSION_SECRET=change-me-to-a-long-random-value
# ATTESTRA_API_KEY_PEPPER=change-me-to-a-long-random-value
# Fernet key for encrypted credential profiles (auth-web). Prefer install scripts:
#   python scripts/ensure_env_secrets.py
#   scripts/install_local.ps1 | .sh   or   scripts/compose_up.ps1 | .sh
# They create .env if needed and fill this when empty; never overwrite a set key. Do not commit.
# ATTESTRA_CREDENTIAL_FERNET_KEY=

# =============================================================================
# Workers / concurrency / orchestrator
# =============================================================================
# Parallel scan jobs per worker process (1-8). Nuclei scans always run one at a time.
# ATTESTRA_WORKER_CONCURRENCY=2
# ATTESTRA_JOB_MAX_ATTEMPTS=3
# ATTESTRA_JOB_STALE_HEARTBEAT_S=120
# ATTESTRA_SCAN_RATE_PER_ASSET=10
# Default orchestrator is inline (durable poller). See Temporal section below for the alternate path.
# ATTESTRA_ORCHESTRATOR=inline

# =============================================================================
# Scanner Docker images (digest pins required)
# =============================================================================
# Digests must be real @sha256 pins before Docker scanners run. Built-in all-zero
# placeholder digests are refused at runtime (see image_is_placeholder).
# Local Compose already defaults ZAP/NUCLEI/TESTSSL/NAABU (see docker/scanner-digests.env
# and compose.yaml); override here only when you need different pins. Other tools:
# ATTESTRA_IMAGE_ZAP=ghcr.io/zaproxy/zaproxy@sha256:7aaa659b0d43078febd82e29bad112285c370727e86ab8340444220e17d9f0d2
# ATTESTRA_IMAGE_NUCLEI=docker.io/projectdiscovery/nuclei@sha256:582d5546902e67052097cb2d07296c642d50a1afc5e44623cb038845df9a32eb
# ATTESTRA_IMAGE_TESTSSL=docker.io/drwetter/testssl.sh@sha256:4a96111aaacfbc2200f4d12f7c32695c2a70392406c505bcb0cdf2a1f1ae0216
# ATTESTRA_IMAGE_NAABU=docker.io/projectdiscovery/naabu@sha256:67c120a669954b768354197fc04328e08027898dc821bc8f276b3e26cd21f6aa
# ATTESTRA_IMAGE_TRIVY=ghcr.io/aquasecurity/trivy@sha256:REPLACE_WITH_REAL_DIGEST
# ATTESTRA_IMAGE_SEMGREP=docker.io/returntocorp/semgrep@sha256:REPLACE_WITH_REAL_DIGEST
# ATTESTRA_IMAGE_GITLEAKS=docker.io/zricethezav/gitleaks@sha256:REPLACE_WITH_REAL_DIGEST
# ATTESTRA_IMAGE_CHECKOV=docker.io/bridgecrew/checkov@sha256:REPLACE_WITH_REAL_DIGEST

# Global scanner timeout (seconds). Per-tool override: ATTESTRA_SCANNER_TIMEOUT_<TOOL>.
# ATTESTRA_SCANNER_TIMEOUT_S=600
# Nuclei-only timeout (seconds). Default 7200; a full baseline at a WAF-safe
# rate can take 45-95 min. ZAP still uses ATTESTRA_SCANNER_TIMEOUT_S.
# ATTESTRA_SCANNER_TIMEOUT_NUCLEI=7200
# Nuclei requests/sec (1-150). Default 30; lower (e.g. 15) if a WAF resets connections.
# ATTESTRA_NUCLEI_RATE_LIMIT=30
# Persistent cache for nuclei templates / trivy DB (defaults under ATTESTRA_DATA_DIR/scanner-cache).
# ATTESTRA_SCANNER_CACHE_DIR=

# =============================================================================
# Compliance note
# =============================================================================
# Framework/control libraries and report template metadata ship in the Python package
# (compliance/data/*.yaml and reports/data/template_config.yaml). No env toggle is
# required for core compliance mapping; keep those package-data paths intact in builds.

# =============================================================================
# Feature flags
# =============================================================================
# Elite automated VAPT orchestrator. Must remain off by default.
ATTESTRA_AUTOMATED_VAPT_ENABLED=false
# Authenticated website testing (auth-web). Off by default (unset/0/false).
ATTESTRA_AUTH_WEB_ENABLED=0
# ATTESTRA_AUTOMATED_VAPT_MUTATION=0
#
# --- Recommended local testing (auth-web + automated VAPT) ---
# Run scripts/ensure_env_secrets.py (or compose_up / install_local) so the Fernet
# key under Auth secrets above is filled. Then set paths/flags as needed and:
#   docker compose up -d --force-recreate api worker
# See README "Local testing: auth-web + automated VAPT".
#
# APP_ENV=local
# ATTESTRA_AUTH_WEB_ENABLED=1
# ATTESTRA_AUTOMATED_VAPT_ENABLED=1
# ATTESTRA_DOCKER_HOST_DATA_DIR=
# ATTESTRA_AUTH_SECRET_DIR=/data/auth-secrets
# ATTESTRA_INITIAL_TEST_RUN_CREDITS=10
# ATTESTRA_AUTOMATED_VAPT_MUTATION=1
# ATTESTRA_CREDENTIAL_ALLOW_EPHEMERAL=1

# =============================================================================
# Upgrade flags (WP1-WP4 + INT). Documentation only: every value shown is the default,
# so leaving these commented keeps existing behaviour. Restart API + worker after changes.
# =============================================================================
# --- Intrusive tests (SSRF / UPLOAD / XSSSTORE / T22) ---
# APP_ENV no longer enables intrusive tests. They need: the per-test flag below, an active
# profile, a target asset whose *environment* is in the allowlist, and (UPLOAD/XSSSTORE/T22)
# a cleanup plan. "production" in the allowlist is rejected at startup.
# ATTESTRA_INTRUSIVE_ALLOWED_ENVIRONMENTS=dev,demo
# ATTESTRA_AUTOMATED_VAPT_SSRF=0
# ATTESTRA_AUTOMATED_VAPT_UPLOAD=0
# ATTESTRA_AUTOMATED_VAPT_STORED_XSS=0
# ATTESTRA_AUTOMATED_VAPT_MUTATION=0
# --- Run validity (WAF / challenge / rate-limit / auth-loss aware results) ---
# enforce: non-VALID cases never PASS and CONFIRMED is capped to POTENTIAL. observe: display only.
# ATTESTRA_RUN_VALIDITY_MODE=enforce
# ATTESTRA_AUTOMATED_VAPT_PLANNER=0      # tiered case planner (order/skip with reasons)
# ATTESTRA_GUIDED_PLANS=0                # guided manual business-logic plans on runs
# --- Safe web / API probes (WP2) ---
# ATTESTRA_PROBES_WEB_SAFE=0             # CORS, Host header, open redirect, auth cache posture
# ATTESTRA_GRAPHQL_PROBE=0               # GraphQL detection + one bounded introspection
# ATTESTRA_API_IMPORT_ENABLED=0          # OpenAPI / Swagger / Postman / HAR import
# ATTESTRA_PROBE_DELAY_MS=250
# ATTESTRA_API_SPEC_MAX_BYTES=5242880
# --- Attack surface / operations (WP4) ---
# ATTESTRA_DISCOVERY_ENABLED=0           # passive subdomain discovery + candidate review
# ATTESTRA_TENANT_STRICT=0               # unscoped repositories fail closed (verify admin views first)
# ATTESTRA_MAINTENANCE_ENABLED=0         # worker maintenance tick
# ATTESTRA_INTEL_AUTO_REFRESH=0          # KEV/EPSS refresh task (needs MAINTENANCE_ENABLED)
# ATTESTRA_INTEL_REFRESH_INTERVAL_S=21600
# ATTESTRA_IMAGE_SUBFINDER=              # digest-pinned images (...@sha256:...)
# ATTESTRA_IMAGE_DNSX=
# ATTESTRA_IMAGE_HTTPX=
# ATTESTRA_HTTPX_BIN=httpx-toolkit       # never the Python "httpx" client
# --- Intel / supply chain (WP3) ---
# ATTESTRA_INTEL_MAX_AGE_HOURS_KEV=      # optional freshness thresholds
# ATTESTRA_INTEL_MAX_AGE_HOURS_EPSS=
# ATTESTRA_LICENSE_POLICY=               # "default" or a YAML/JSON path: licence findings from CycloneDX
# --- K-04 ---
# With APP_ENV=staging or production, startup now fails if ATTESTRA_API_KEY_PEPPER or
# ATTESTRA_SESSION_SECRET still use the built-in development defaults.

# =============================================================================
# Bypass flags (local / test / development only)
# =============================================================================
# Local-testing bypasses. Default false when unset. Never enable in staging/production
# (startup rejects that combination). Independent of each other.
BYPASS_TARGET_OWNERSHIP_VERIFICATION=false
BYPASS_SIGNED_AUTHORIZATION_VERIFICATION=false

# Example local-only unlock (never use in shared environments):
# APP_ENV=local
# BYPASS_TARGET_OWNERSHIP_VERIFICATION=true
# BYPASS_SIGNED_AUTHORIZATION_VERIFICATION=true

# =============================================================================
# Optional Temporal (commented)
# =============================================================================
# Requires optional extra: pip install '.[temporal]' and a reachable Temporal server.
# ATTESTRA_ORCHESTRATOR=temporal
# ATTESTRA_TEMPORAL_ADDRESS=localhost:7233
# ATTESTRA_TEMPORAL_NAMESPACE=default
# ATTESTRA_TEMPORAL_TASK_QUEUE=attestra-scans

# =============================================================================
# Subscription / credits
# =============================================================================
# Organization test-run credit enforcement. ON (default when unset) enforces
# credits. OFF bypasses only subscription credit checks; auth, tenant isolation,
# scope, SSRF, and audit stay on.
SUBSCRIPTION_SERVICE=ON
# ATTESTRA_INITIAL_TEST_RUN_CREDITS=3
# ATTESTRA_CREDIT_REFUND_ON_PRE_START_FAILURE=ON
# ATTESTRA_CREDIT_REFUND_ON_POST_START_FAILURE=OFF

# =============================================================================
# AI narratives (optional Step 8.5) — see docs/AI_NARRATIVES.md
# =============================================================================
# Off by default. When on, drafts need tester/lead/admin approval before reports.
# Prefer local Ollama; for openai provider prefer secret_store key ai_api_key.
# --- AI narratives (disabled by default) ---
ATTESTRA_AI_NARRATIVES=off
ATTESTRA_AI_PROVIDER=ollama
ATTESTRA_AI_BASE_URL=http://localhost:11434
ATTESTRA_AI_MODEL=llama3.1
# ATTESTRA_AI_API_KEY=                    # placeholder only; prefer Vault/secret_store
# ATTESTRA_AI_TENANTS_OFF=                # comma-separated tenant ids with AI off

# =============================================================================
# AASI (Attestra Agentic Security Intelligence) — see docs/ai_security/
# =============================================================================
# Off by default. Reuses ATTESTRA_AI_* for provider/model (do not invent AASI_PROVIDER).
# Bounded budgets and human approval required for intrusive recommendations.
# --- AASI (disabled by default) ---
ATTESTRA_AASI=off
ATTESTRA_AASI_MAX_ITERATIONS=8
ATTESTRA_AASI_MAX_TASKS=32
ATTESTRA_AASI_MAX_MODEL_CALLS=40
ATTESTRA_AASI_MAX_TOKENS=50000
ATTESTRA_AASI_MAX_WALL_CLOCK_S=1800
ATTESTRA_AASI_RETRY_LIMIT=2
ATTESTRA_AASI_REQUIRE_APPROVAL=on

# AASI scanner images (digest pins required; placeholders refused at runtime).
# Replace REPLACE_AFTER_INSPECT with a real digest from `docker inspect` (Phase 9).
# ATTESTRA_IMAGE_GARAK=docker.io/nvidia/garak@sha256:REPLACE_AFTER_INSPECT
# ATTESTRA_IMAGE_PROMPTFOO=ghcr.io/promptfoo/promptfoo@sha256:REPLACE_AFTER_INSPECT
# ATTESTRA_IMAGE_SAFELABS=docker.io/agentsafelabs/safelabs-eval@sha256:REPLACE_AFTER_INSPECT
