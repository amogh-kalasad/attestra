# Attestra environment template. Copy to `.env` or export in the shell.
# Changing most values requires restarting the API process and any workers.

# Organization test-run credit enforcement. ON (default when unset) enforces
# credits once Phase 2 accounting is active. OFF bypasses only subscription
# credit checks; auth, tenant isolation, scope, SSRF, and audit stay on.
SUBSCRIPTION_SERVICE=ON
# ATTESTRA_INITIAL_TEST_RUN_CREDITS=3
# ATTESTRA_CREDIT_REFUND_ON_PRE_START_FAILURE=ON
# ATTESTRA_CREDIT_REFUND_ON_POST_START_FAILURE=OFF

# Signed authorization gate for imports/scans. ON (default when unset) requires
# a currently valid authorization covering the target environment. OFF skips
# only those gates; document download RBAC, tenant isolation, ownership, SSRF,
# and audit stay on. UI can still record authorizations.
SIGNED_AUTHORIZATION=ON

# Ownership verification gate for web/api/host scans. ON (default when unset)
# refuses scans until ownership is verified. OFF skips only that policy check;
# UI verify/confirm and other controls stay available.
OWNERSHIP_VERIFICATION=ON

# ATTESTRA_DATA_DIR=./data
# ATTESTRA_DATABASE_URL=sqlite:///./data/attestra.db
# ATTESTRA_SESSION_SECRET=change-me-to-a-long-random-value
# ATTESTRA_PUBLIC_URL=http://127.0.0.1:8000
# ATTESTRA_EVIDENCE_MAX_BYTES=20971520
# ATTESTRA_AUTH_WEB_ENABLED=0
# ATTESTRA_CREDENTIAL_FERNET_KEY=
