# Attestra environment template. Copy to `.env` or export in the shell.
# Changing most values requires restarting the API process and any workers.
# Placeholders only — never commit real passwords, API keys, or production secrets.

# =============================================================================
# Application / APP_ENV
# =============================================================================
# Deployment environment. Known: local, test, development, staging, production.
# Bypass flags only activate when APP_ENV is local, test, or development.
# Unset APP_ENV is allowed when both bypass flags are false (checks stay mandatory).
APP_ENV=local

# ATTESTRA_DATA_DIR=./data
# ATTESTRA_PUBLIC_URL=http://127.0.0.1:8000
# ATTESTRA_EVIDENCE_MAX_BYTES=20971520

# =============================================================================
# MongoDB
# =============================================================================
# Host venv / local mongod (replica set required for multi-document transactions):
ATTESTRA_MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
ATTESTRA_MONGODB_DB=attestra
# Optional: separate URI for tests (throwaway DBs must be named attestra_test_*)
ATTESTRA_TEST_MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
#
# Docker Compose sets the in-network URI for API/worker services, e.g.:
#   ATTESTRA_MONGODB_URI=mongodb://mongo:27017/?replicaSet=rs0
# With auth enabled (preferred for shared/Compose setups):
#   mongodb://attestra_app:<password>@mongo:27017/?replicaSet=rs0&authSource=admin
# Host-side tools still use 127.0.0.1 (or localhost) against the published port.
# Securing local MongoDB (users, auth, keyFile, bind 127.0.0.1):
# docs/mongodb_migration/SECURE_LOCAL_MONGO.md

# =============================================================================
# Persistence / storage / GridFS
# =============================================================================
# Runtime is MongoDB only. ATTESTRA_PERSISTENCE is retained for older deploy env files.
# ATTESTRA_PERSISTENCE=mongo
# Artifact store: mongo (GridFS) | local (files in ATTESTRA_DATA_DIR) | s3.
# Defaults to mongo.
# ATTESTRA_STORAGE=mongo
# GridFS bucket for durable artifacts (reports, evidence, raw tool output).
ATTESTRA_MONGODB_GRIDFS_BUCKET=attestra_artifacts
# ATTESTRA_MONGODB_TLS=false
# ATTESTRA_MONGODB_TLS_CA_FILE=
# ATTESTRA_MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# ATTESTRA_MONGODB_CONNECT_TIMEOUT_MS=5000
# ATTESTRA_MONGODB_SOCKET_TIMEOUT_MS=30000
# ATTESTRA_MONGODB_MAX_POOL_SIZE=50
# Optional S3 when ATTESTRA_STORAGE=s3 (requires optional .[s3]):
# ATTESTRA_S3_BUCKET=
# ATTESTRA_S3_ENDPOINT=
# ATTESTRA_S3_OBJECT_LOCK=false

# =============================================================================
# Auth secrets (placeholders — replace before any shared environment)
# =============================================================================
# ATTESTRA_SESSION_SECRET=change-me-to-a-long-random-value
# ATTESTRA_API_KEY_PEPPER=change-me-to-a-long-random-value
# Fernet key for encrypted credential profiles (auth-web). Generate a fresh key; never reuse samples.
# ATTESTRA_CREDENTIAL_FERNET_KEY=

# =============================================================================
# Workers / concurrency / orchestrator
# =============================================================================
# Parallel scan jobs per worker process (1-8). Nuclei scans always run one at a time.
# ATTESTRA_WORKER_CONCURRENCY=2
# ATTESTRA_JOB_MAX_ATTEMPTS=3
# ATTESTRA_JOB_STALE_HEARTBEAT_S=120
# ATTESTRA_SCAN_RATE_PER_ASSET=10
# Default orchestrator is inline (durable poller). See Temporal section below for the alternate path.
# ATTESTRA_ORCHESTRATOR=inline

# =============================================================================
# Scanner Docker images (digest pins required)
# =============================================================================
# Digests must be real @sha256 pins before Docker scanners run. Built-in all-zero
# placeholder digests are refused at runtime (see image_is_placeholder). Replace
# each value after `docker inspect` / registry digest lookup. Tools:
#   ZAP TRIVY NUCLEI SEMGREP TESTSSL NAABU GITLEAKS CHECKOV
# ATTESTRA_IMAGE_ZAP=ghcr.io/zaproxy/zaproxy@sha256:REPLACE_WITH_REAL_DIGEST
# ATTESTRA_IMAGE_TRIVY=ghcr.io/aquasecurity/trivy@sha256:REPLACE_WITH_REAL_DIGEST
# ATTESTRA_IMAGE_NUCLEI=docker.io/projectdiscovery/nuclei@sha256:REPLACE_WITH_REAL_DIGEST
# ATTESTRA_IMAGE_SEMGREP=docker.io/returntocorp/semgrep@sha256:REPLACE_WITH_REAL_DIGEST
# ATTESTRA_IMAGE_TESTSSL=docker.io/drwetter/testssl.sh@sha256:REPLACE_WITH_REAL_DIGEST
# ATTESTRA_IMAGE_NAABU=docker.io/projectdiscovery/naabu@sha256:REPLACE_WITH_REAL_DIGEST
# ATTESTRA_IMAGE_GITLEAKS=docker.io/zricethezav/gitleaks@sha256:REPLACE_WITH_REAL_DIGEST
# ATTESTRA_IMAGE_CHECKOV=docker.io/bridgecrew/checkov@sha256:REPLACE_WITH_REAL_DIGEST

# Global scanner timeout (seconds). Per-tool override: ATTESTRA_SCANNER_TIMEOUT_<TOOL>.
# ATTESTRA_SCANNER_TIMEOUT_S=600
# Persistent cache for nuclei templates / trivy DB (defaults under ATTESTRA_DATA_DIR/scanner-cache).
# ATTESTRA_SCANNER_CACHE_DIR=

# =============================================================================
# Compliance note
# =============================================================================
# Framework/control libraries and report template metadata ship in the Python package
# (compliance/data/*.yaml and reports/data/template_config.yaml). No env toggle is
# required for core compliance mapping; keep those package-data paths intact in builds.

# =============================================================================
# Feature flags
# =============================================================================
# Elite automated VAPT orchestrator. Must remain off by default.
ATTESTRA_AUTOMATED_VAPT_ENABLED=false
# Authenticated website testing (auth-web). Off by default (unset/0/false).
ATTESTRA_AUTH_WEB_ENABLED=0
# ATTESTRA_AUTOMATED_VAPT_MUTATION=0

# =============================================================================
# Bypass flags (local / test / development only)
# =============================================================================
# Local-testing bypasses. Default false when unset. Never enable in staging/production
# (startup rejects that combination). Independent of each other.
BYPASS_TARGET_OWNERSHIP_VERIFICATION=false
BYPASS_SIGNED_AUTHORIZATION_VERIFICATION=false

# Example local-only unlock (never use in shared environments):
# APP_ENV=local
# BYPASS_TARGET_OWNERSHIP_VERIFICATION=true
# BYPASS_SIGNED_AUTHORIZATION_VERIFICATION=true

# =============================================================================
# Optional Temporal (commented)
# =============================================================================
# Requires optional extra: pip install '.[temporal]' and a reachable Temporal server.
# ATTESTRA_ORCHESTRATOR=temporal
# ATTESTRA_TEMPORAL_ADDRESS=localhost:7233
# ATTESTRA_TEMPORAL_NAMESPACE=default
# ATTESTRA_TEMPORAL_TASK_QUEUE=attestra-scans

# =============================================================================
# Subscription / credits
# =============================================================================
# Organization test-run credit enforcement. ON (default when unset) enforces
# credits. OFF bypasses only subscription credit checks; auth, tenant isolation,
# scope, SSRF, and audit stay on.
SUBSCRIPTION_SERVICE=ON
# ATTESTRA_INITIAL_TEST_RUN_CREDITS=3
# ATTESTRA_CREDIT_REFUND_ON_PRE_START_FAILURE=ON
# ATTESTRA_CREDIT_REFUND_ON_POST_START_FAILURE=OFF
