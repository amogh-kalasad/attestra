# Attestra production environment template.
# Copy to a secrets-managed store or a non-committed `.env.production`.
# Placeholders only — never commit real passwords, API keys, or signing secrets.
# Prefer Vault/OpenBao (ATTESTRA_SECRETS_BACKEND=vault) for AI and OIDC secrets.

# =============================================================================
# Application / APP_ENV
# =============================================================================
APP_ENV=production
# ATTESTRA_DATA_DIR=/data
# ATTESTRA_PUBLIC_URL=https://attestra.example.com
# ATTESTRA_EVIDENCE_MAX_BYTES=20971520

# =============================================================================
# MongoDB (authenticated URI required in production)
# =============================================================================
# ATTESTRA_MONGODB_URI=mongodb://attestra_app:REPLACE_PASSWORD@mongo:27017/?replicaSet=rs0&authSource=admin&tls=true
ATTESTRA_MONGODB_DB=attestra
ATTESTRA_MONGODB_GRIDFS_BUCKET=attestra_artifacts
# ATTESTRA_MONGODB_TLS=true
# ATTESTRA_MONGODB_TLS_CA_FILE=
ATTESTRA_STORAGE=mongo
# ATTESTRA_PERSISTENCE=mongo

# =============================================================================
# Auth secrets (unique strong values — K-04 refuses built-in defaults)
# =============================================================================
# ATTESTRA_SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_VALUE
# ATTESTRA_API_KEY_PEPPER=REPLACE_WITH_LONG_RANDOM_VALUE
# ATTESTRA_CREDENTIAL_FERNET_KEY=REPLACE_WITH_FERNET_KEY
# ATTESTRA_SECRETS_BACKEND=vault
# ATTESTRA_AUTH_SECRET_DIR=/data/auth-secrets

# =============================================================================
# Workers / orchestrator
# =============================================================================
# ATTESTRA_WORKER_CONCURRENCY=2
# ATTESTRA_ORCHESTRATOR=inline
# ATTESTRA_JOB_MAX_ATTEMPTS=3
# ATTESTRA_JOB_STALE_HEARTBEAT_S=120

# =============================================================================
# Scanner Docker images (digest pins required; no floating tags)
# =============================================================================
# Pin real @sha256 digests for every scanner you run. All-zero placeholders are refused.
# See docker/scanner-digests.env for Compose web-scanner pins.
# ATTESTRA_IMAGE_ZAP=ghcr.io/zaproxy/zaproxy@sha256:REPLACE_WITH_REAL_DIGEST
# ATTESTRA_IMAGE_NUCLEI=docker.io/projectdiscovery/nuclei@sha256:REPLACE_WITH_REAL_DIGEST
# ATTESTRA_IMAGE_TESTSSL=docker.io/drwetter/testssl.sh@sha256:REPLACE_WITH_REAL_DIGEST
# ATTESTRA_IMAGE_NAABU=docker.io/projectdiscovery/naabu@sha256:REPLACE_WITH_REAL_DIGEST
# ATTESTRA_SCANNER_TIMEOUT_S=600
# ATTESTRA_SCANNER_TIMEOUT_NUCLEI=7200
# ATTESTRA_NUCLEI_RATE_LIMIT=30

# =============================================================================
# Feature flags (fail-closed defaults for production)
# =============================================================================
ATTESTRA_AUTOMATED_VAPT_ENABLED=false
ATTESTRA_AUTH_WEB_ENABLED=0
ATTESTRA_AUTOMATED_VAPT_MUTATION=0
ATTESTRA_INTRUSIVE_ALLOWED_ENVIRONMENTS=dev,demo
ATTESTRA_AUTOMATED_VAPT_SSRF=0
ATTESTRA_AUTOMATED_VAPT_UPLOAD=0
ATTESTRA_AUTOMATED_VAPT_STORED_XSS=0
ATTESTRA_RUN_VALIDITY_MODE=enforce
ATTESTRA_AUTOMATED_VAPT_PLANNER=0
ATTESTRA_GUIDED_PLANS=0
ATTESTRA_PROBES_WEB_SAFE=0
ATTESTRA_GRAPHQL_PROBE=0
ATTESTRA_API_IMPORT_ENABLED=0
ATTESTRA_DISCOVERY_ENABLED=0
# ATTESTRA_TENANT_STRICT=1
# ATTESTRA_MAINTENANCE_ENABLED=0
# ATTESTRA_INTEL_AUTO_REFRESH=0

# =============================================================================
# Bypass flags — must stay false in staging/production (startup enforces)
# =============================================================================
BYPASS_TARGET_OWNERSHIP_VERIFICATION=false
BYPASS_SIGNED_AUTHORIZATION_VERIFICATION=false

# =============================================================================
# Subscription / credits
# =============================================================================
SUBSCRIPTION_SERVICE=ON
# ATTESTRA_INITIAL_TEST_RUN_CREDITS=3
# ATTESTRA_CREDIT_REFUND_ON_PRE_START_FAILURE=ON
# ATTESTRA_CREDIT_REFUND_ON_POST_START_FAILURE=OFF

# =============================================================================
# AI narratives (optional Step 8.5) — see docs/AI_NARRATIVES.md
# =============================================================================
# Keep off unless operators enable and approve drafts. Prefer on-prem Ollama.
# --- AI narratives (disabled by default) ---
ATTESTRA_AI_NARRATIVES=off
ATTESTRA_AI_PROVIDER=ollama
# ATTESTRA_AI_BASE_URL=http://ollama.internal:11434
ATTESTRA_AI_MODEL=llama3.1
# ATTESTRA_AI_API_KEY=                    # prefer secret_store ai_api_key; never commit
# ATTESTRA_AI_TENANTS_OFF=

# =============================================================================
# AASI (Attestra Agentic Security Intelligence) — see docs/ai_security/
# =============================================================================
# Keep off until Phase 8+ production readiness. Approval required when enabled.
# --- AASI (disabled by default) ---
ATTESTRA_AASI=off
ATTESTRA_AASI_MAX_ITERATIONS=8
ATTESTRA_AASI_MAX_TASKS=32
ATTESTRA_AASI_MAX_MODEL_CALLS=40
ATTESTRA_AASI_MAX_TOKENS=50000
ATTESTRA_AASI_MAX_WALL_CLOCK_S=1800
ATTESTRA_AASI_RETRY_LIMIT=2
ATTESTRA_AASI_REQUIRE_APPROVAL=on

# AASI scanner images (digest pins required; placeholders refused at runtime).
# Build from docker/aasi/ or pull Promptfoo from GHCR — see docker/aasi/README.md
# ATTESTRA_IMAGE_GARAK=attestra/garak@sha256:REPLACE_AFTER_INSPECT
# ATTESTRA_IMAGE_PROMPTFOO=ghcr.io/promptfoo/promptfoo@sha256:REPLACE_AFTER_INSPECT
# ATTESTRA_IMAGE_SAFELABS=attestra/safelabs@sha256:REPLACE_AFTER_INSPECT
# ATTESTRA_IMAGE_PYRIT=attestra/pyrit-worker@sha256:REPLACE_AFTER_INSPECT
