# Attestra AASI — Garak worker (reference: https://github.com/NVIDIA/garak)
# Matches GarakAdapter: docker_entrypoint=python → python -m garak
# Do not bake into the main Attestra API image.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Pin a known release in CI/ops when you need bit-for-bit rebuilds:
#   pip install "garak==X.Y.Z"
RUN pip install --upgrade pip \
    && pip install "garak>=0.10.0"

WORKDIR /work
# Default CMD unused — Attestra overrides entrypoint/argv.
ENTRYPOINT ["python", "-m", "garak"]
