# Attestra AASI — PyRIT isolated worker (reference: https://github.com/microsoft/PyRIT)
# Ships microsoft PyRIT + thin Attestra CLI module `attestra_pyrit_worker`
# Matches PyRITAdapter: python -m attestra_pyrit_worker run --config … --output … --scenario …
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYRIT_DISABLE_EXTERNAL_JUDGE=1 \
    PYRIT_DISABLE_ADVERSARIAL_EGRESS=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/attestra-pyrit
COPY pyrit_worker/ /opt/attestra-pyrit/pyrit_worker/

RUN pip install --upgrade pip \
    && pip install "pyrit>=0.9.0" "httpx>=0.27.0" \
    && pip install -e /opt/attestra-pyrit/pyrit_worker

WORKDIR /work
ENTRYPOINT ["python", "-m", "attestra_pyrit_worker"]
