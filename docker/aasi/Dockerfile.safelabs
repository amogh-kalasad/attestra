# Attestra AASI — SafeLabs worker (reference: https://github.com/AgentSafeLabs/safelabs-eval)
# Package: pip install safelabs-eval → CLI `safelabs`
# Matches SafeLabsAdapter: docker_entrypoint=safelabs
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip \
    && pip install "safelabs-eval>=0.12.0"

WORKDIR /work
ENTRYPOINT ["safelabs"]
