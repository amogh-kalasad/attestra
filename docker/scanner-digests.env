# Digest-pinned scanner images for local Docker Compose (web targets).
# compose.yaml bakes the same values as ${ATTESTRA_IMAGE_*} defaults so
# `docker compose up -d --build` works even without a project .env.
# Override any pin via root `.env` or the shell; placeholders are refused.

ATTESTRA_IMAGE_ZAP=ghcr.io/zaproxy/zaproxy@sha256:7aaa659b0d43078febd82e29bad112285c370727e86ab8340444220e17d9f0d2
ATTESTRA_IMAGE_NUCLEI=docker.io/projectdiscovery/nuclei@sha256:582d5546902e67052097cb2d07296c642d50a1afc5e44623cb038845df9a32eb
ATTESTRA_IMAGE_TESTSSL=docker.io/drwetter/testssl.sh@sha256:4a96111aaacfbc2200f4d12f7c32695c2a70392406c505bcb0cdf2a1f1ae0216
ATTESTRA_IMAGE_NAABU=docker.io/projectdiscovery/naabu@sha256:67c120a669954b768354197fc04328e08027898dc821bc8f276b3e26cd21f6aa
