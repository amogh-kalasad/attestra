def test_engagements_comments_assignments_collapse_from_mongo(seeded, monkeypatch):
    from types import SimpleNamespace

    from attestra import assignments, comments, crossmerge, db, services
    from attestra.models import Engagement, User

    with db.session() as s:
        tid = s.get(Engagement, seeded).tenant_id
        u = User(username="alice", role="tester", tenant_id=tid, password_hash="x", active=True)
        s.add(u)
        s.flush()
        uid = u.id
    p = SimpleNamespace(role="tester", tenant_id=tid, user_id=uid, actor="alice", username="alice")
    admin = SimpleNamespace(role="admin", tenant_id=None, user_id=None, actor="admin")
    monkeypatch.delenv("ATTESTRA_MONGO_READS", raising=False)
    with db.session() as s:
        fids = [f.id for f in services.list_findings(s, seeded)]
        comments.add_comment(s, fids[0], body="first", principal=p)
        comments.add_comment(s, fids[0], body="second", principal=p)
        assignments.assign_finding(s, fids[0], assignee="alice", actor="lead")

    def run(s):
        return (
            [e.id for e in services.list_engagements(s, admin)],
            [e.id for e in services.list_engagements(s, p)],
            [(c["body"] if isinstance(c, dict) else c) for c in comments.list_comments(s, fids[0], p)],
            {k: [c.body for c in v] for k, v in comments.comments_for_findings(s, fids).items()},
            assignments.assignees_for_engagement(s, seeded),
            [(f.id, getattr(f, "cross_sources", None) is not None) for f in crossmerge.collapse(s, services.list_findings(s, seeded))],
        )

    with db.session() as s:
        sql = run(s)
    monkeypatch.setenv("ATTESTRA_MONGO_READS", "domain")
    with db.session() as s:
        mongo = run(s)
    assert sql == mongo
    assert sql[2] == ["first", "second"] and sql[4] == {fids[0]: "alice"} and seeded in sql[1]
