{% extends "_base.html.j2" %}
{% block title %}Technical security testing report{% endblock %}
{% block body %}
{% set sec = namespace(n=0) %}
<nav class="toc" id="toc">
  <h2>Contents</h2>
  <ol>
    <li><a href="#document-control">Document control</a></li>
    <li><a href="#distribution">Distribution list</a></li>
    {% if figures %}<li><a href="#list-of-figures">List of figures</a></li>{% endif %}
    <li><a href="#scope">Scope and authorization</a></li>
    <li><a href="#methodology">Methodology and data sources</a></li>
    <li><a href="#tools-and-versions">Tools and versions</a></li>
    <li><a href="#standards">Standards and test types</a></li>
    <li><a href="#risk-legend">Risk Rating Legend</a></li>
    <li><a href="#summary">Summary</a></li>
    <li><a href="#findings-overview">Findings overview</a></li>
    {% if passed_checks %}<li><a href="#status-checks">Status checks</a></li>{% endif %}
    {% if security_testing_coverage %}<li><a href="#security-testing-coverage">Security testing coverage</a></li>{% endif %}
    {% if automated_coverage_limitations and automated_coverage_limitations.section %}<li><a href="#automated-coverage-limitations">Automated coverage and limitations</a></li>{% endif %}
    {% if auth_checklist_section %}<li><a href="#auth-checklist">Authenticated security testing checklist</a></li>{% endif %}
    {% if site_grades %}<li><a href="#site-grades">Site grades</a></li>{% endif %}
    {% if tls_summaries %}<li><a href="#tls">TLS summary</a></li>{% endif %}
    <li><a href="#findings">Detailed findings</a></li>
    {% if automated_runs is defined and automated_runs %}<li><a href="#automated-testing-evidence">Automated testing evidence</a></li>{% endif %}
    <li><a href="#disclaimer">Assumptions, limitations and confidentiality</a></li>
    <li><a href="#retesting">Retesting information</a></li>
    <li><a href="#conclusion">Conclusion</a></li>
    <li><a href="#sign-off">Sign-off / QA and approval</a></li>
    <li><a href="#appendix">Appendix</a></li>
  </ol>
</nav>

{% set sec.n = sec.n + 1 %}<h2 id="document-control">{{ sec.n }}. Document control</h2>
<p class="meta">This generation is a <b>DRAFT</b> until QA approval and signature complete in Attestra. QA and Approved stay as explicit pending placeholders below; prior versions show recorded QA/signer names when present.</p>
<table>
  <tr><th>Version</th><th>Status</th><th>Generated</th><th>Author</th><th>QA</th><th>Approved</th><th>Change</th><th>SHA-256</th></tr>
  <tr>
    <td>v{{ version }}</td>
    <td>Draft (this generation)</td>
    <td>{{ generated_at|format_date }}</td>
    <td>{{ generated_by }}</td>
    <td>Pending QA (DRAFT)</td>
    <td>Pending approval (DRAFT)</td>
    <td>Draft generated</td>
    <td class="mono">pending freeze</td>
  </tr>
  {% for r in report_history %}
  <tr>
    <td>v{{ r.version }}</td>
    <td>{{ r.status|status_label }}</td>
    <td>{{ r.generated_at|format_date if r.generated_at else "—" }}</td>
    <td>{{ r.generated_by }}</td>
    <td>{% if r.qa_by %}{{ r.qa_by }}{% elif r.status in ("draft", "submitted", "rejected") %}Pending QA (DRAFT){% else %}—{% endif %}</td>
    <td>{% if r.approved_by %}{{ r.approved_by }}{% elif r.status == "signed" %}—{% elif r.status == "qa_approved" %}Pending signature{% else %}Pending approval (DRAFT){% endif %}</td>
    <td>{{ r.change or "—" }}</td>
    <td class="mono">{{ r.sha256[:16] }}…</td>
  </tr>
  {% endfor %}
</table>
{% if contact_name or contact_email %}
<p class="meta">Tester / client contact: {{ contact_name or "—" }}{% if contact_email %} · {{ contact_email }}{% endif %}</p>
{% endif %}

{% set sec.n = sec.n + 1 %}<h2 id="distribution">{{ sec.n }}. Distribution list</h2>
<p class="meta">This report is confidential. Distribute only to the parties below and other recipients authorized in writing by {{ tenant }}.</p>
<table>
  <tr><th>Role</th><th>Name / organization</th><th>Email</th><th>Copies</th></tr>
  {% for d in distribution %}
  <tr>
    <td>{{ d.role }}</td>
    <td>{{ d.name }}</td>
    <td>{% if d.email and d.email != "—" %}<span class="mono">{{ d.email }}</span>{% else %}—{% endif %}</td>
    <td>{{ d.copies }}</td>
  </tr>
  {% else %}
  <tr><td colspan="4">No distribution entries recorded. Limit circulation to authorized client contacts.</td></tr>
  {% endfor %}
</table>

{% if figures %}
{% set sec.n = sec.n + 1 %}<h2 id="list-of-figures">{{ sec.n }}. List of figures</h2>
<table>
  <tr><th>Figure</th><th>Caption</th><th>Finding</th></tr>
  {% for fig in figures %}
  <tr>
    <td class="mono"><a href="#fig-{{ fig.id }}">Fig. {{ fig.label }}</a></td>
    <td>{{ fig.caption }}</td>
    <td class="mono"><a href="#finding-{{ fig.finding_id }}">{{ flabel(fig.finding_id) }}</a></td>
  </tr>
  {% endfor %}
</table>
{% endif %}

{% set sec.n = sec.n + 1 %}<h2 id="scope">{{ sec.n }}. Scope and authorization</h2>
<div class="meta">Type: {{ type_label }} · Window: {{ eng.window_start or "n/a" }} to {{ eng.window_end or "n/a" }} · Frameworks: {{ eng.frameworks|frameworks_label }}</div>
<table>
  <tr><th>Environment URL</th><th>Type</th><th>Environment</th><th>Criticality</th><th>Exposure</th><th>PCI CDE</th><th>Test types</th></tr>
  {% for a in eng.assets %}
  <tr>
    <td class="mono">{{ a.identifier }}</td>
    <td>{{ asset_kind_label(a.kind) if asset_kind_label is defined else a.kind }}</td>
    <td>{{ a.environment|environment_label }}</td>
    <td>{{ a.criticality }}/5</td>
    <td>{{ effective_exposure_label(a) if effective_exposure_label is defined else a.exposure|exposure_label }}</td>
    <td>{{ "Yes" if a.in_cde else "No" }}</td>
    <td>{% if a.test_types %}{% if test_type_label is defined %}{% for k in a.test_types %}{{ test_type_label(k) }}{% if not loop.last %}, {% endif %}{% endfor %}{% else %}{{ a.test_types|join(", ") }}{% endif %}{% else %}—{% endif %}</td>
  </tr>
  {% else %}<tr><td colspan="7">No assets recorded.</td></tr>{% endfor %}
</table>
<table>
  <tr><th>Authorization document</th><th>Signer</th><th>Valid</th><th>Environments</th><th>SHA-256</th></tr>
  {% for a in authorizations %}
  <tr>
    <td>{{ a.document_name }}</td>
    <td>{{ a.signer }}</td>
    <td>{{ a.signed_on }} to {{ a.expires_on }}</td>
    <td>{% if a.environments %}{% for env in a.environments %}{{ env|environment_label }}{% if not loop.last %}, {% endif %}{% endfor %}{% else %}{{ "all"|environment_label }}{% endif %}</td>
    <td class="mono">{{ a.sha256 }}</td>
  </tr>
  {% endfor %}
</table>

{% set sec.n = sec.n + 1 %}<h2 id="methodology">{{ sec.n }}. Methodology and data sources</h2>
<ol>
  {% for phase in methodology_phases %}
  <li>{{ phase }}</li>
  {% endfor %}
</ol>
<p>Automated assessment results were imported from the tools below, normalized to a common schema, de-duplicated by fingerprint
and ranked by risk (CVSS × (1 + EPSS) × KEV × asset criticality × exposure). Manual validation follows the OWASP Web Security
Testing Guide (WSTG); a finding is marked <em>validated</em> only after a named tester confirms it with evidence.</p>
{% if feed_catalog and (feed_catalog.kev_date or feed_catalog.epss_date) %}
<p class="meta">Threat intel catalogs: KEV {{ feed_catalog.kev_date or "n/a" }} · EPSS {{ feed_catalog.epss_date or "n/a" }}</p>
{% endif %}
<table>
  <tr><th>#</th><th>Tool</th><th>File</th><th>Imported</th><th>New / merged</th><th>SHA-256 (raw)</th></tr>
  {% for i in imports %}
  <tr><td>{{ i.id }}</td><td>{{ i.tool|tool_label }}</td><td>{{ i.filename }}</td><td>{{ i.imported_at|format_date }} by {{ i.imported_by }}</td><td>{{ i.new_findings }} / {{ i.updated_findings }}</td><td class="mono">{{ i.sha256 }}</td></tr>
  {% else %}<tr><td colspan="6">No results imported.</td></tr>{% endfor %}
</table>
{% if scan_history %}
<p class="meta">Scan runs recorded for this engagement (newest first; failed or incomplete scans are not evidence of absence of vulnerabilities).</p>
<table>
  <tr><th>Scan</th><th>Tool</th><th>Status</th><th>Started</th><th>Ended</th><th>Refusal Reason</th></tr>
  {% for run in scan_history[:20] %}
  <tr>
    <td>{{ run.id }}</td>
    <td>{{ run.tool|tool_label }}</td>
    <td>{{ run.status|status_label }}</td>
    <td>{{ run.started_at|format_datetime if run.started_at else "—" }}</td>
    <td>{{ run.ended_at|format_datetime if run.ended_at else "—" }}</td>
    <td>{{ run.refuse_reason or "—" }}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}

{% set sec.n = sec.n + 1 %}<h2 id="tools-and-versions">{{ sec.n }}. Tools and versions</h2>
<p class="meta">Distinct tools seen on findings, observations, imports, and scan runs. Versions are taken only from recorded <span class="mono">tool_version</span> fields; unknown versions are labeled “version not recorded” and are never invented.</p>
<table>
  <tr><th>Tool</th><th>Version</th><th>Notes</th></tr>
  {% for row in tools_and_versions %}
  <tr>
    <td>{{ row.tool|tool_label }}</td>
    <td class="mono">{{ row.version }}</td>
    <td>{{ row.notes or "—" }}</td>
  </tr>
  {% else %}
  <tr><td colspan="3">No tools recorded for this engagement yet.</td></tr>
  {% endfor %}
</table>

{% set sec.n = sec.n + 1 %}<h2 id="standards">{{ sec.n }}. Standards and test types</h2>
{% if test_types %}
<table>
  <tr><th>Test type</th><th>Standard</th></tr>
  {% for t in test_types %}
  <tr><td>{{ t.label }}</td><td>{{ t.standard }}</td></tr>
  {% endfor %}
</table>
{% else %}
<p class="meta">No explicit test types recorded on assets; defaults apply per asset kind when scans run.</p>
{% endif %}
{% if standards %}
<p><b>Standards referenced:</b> {{ standards|join("; ") }}</p>
{% endif %}

{% set sec.n = sec.n + 1 %}<h2 id="risk-legend">{{ sec.n }}. Risk Rating Legend</h2>
<p class="meta"><b>Technical severity</b> (Critical–Info) follows CVSS score bands. It is the technical severity of record for each finding.</p>
<table>
  <tr><th>Severity</th><th>CVSS range</th><th>Open vuln count</th></tr>
  {% for s in severities %}
  <tr>
    <td><span class="sev sev-{{ s }}">{{ s|severity_label }}</span></td>
    <td>{{ cvss_legend.get(s, "—") }}</td>
    <td>{{ by_sev.get(s, 0) }}</td>
  </tr>
  {% endfor %}
</table>
<p class="meta"><b>Priority / business risk score</b> ranks remediation work
(CVSS × (1 + EPSS) × KEV × asset criticality × exposure). It is <em>not</em> a second CVSS score and does not replace technical severity.
Open counts above exclude informational and not-reproducible validation observations{% if informational_open %}; {{ informational_open }} such observation{{ "s" if informational_open != 1 else "" }} remain listed in detailed findings where present{% endif %}.
CVSS vector and version appear on individual findings when available.</p>

{% set sec.n = sec.n + 1 %}<h2 id="summary">{{ sec.n }}. Summary</h2>
<div class="summary-posture">
<div class="kpis">
  {% for s in severities %}
  <div class="kpi"><span class="sev sev-{{ s }}">{{ s|severity_label }}</span><b>{{ by_sev.get(s, 0) }}</b>open vulns</div>
  {% endfor %}
  <div class="kpi">False positives<b>{{ false_positives }}</b>excluded</div>
  {% if informational_open %}<div class="kpi">Informational / N/R<b>{{ informational_open }}</b>not confirmed vulns</div>{% endif %}
</div>
{% if trend_svg %}
<div class="chart-block">
  <p class="meta chart-caption">Open vulnerabilities by severity (informational and not-reproducible validation classes excluded).{% if prev_by_sev is none %} No prior engagement for this client — chart shows current open counts only.{% endif %}</p>
  {{ trend_svg|safe }}
</div>
{% endif %}
</div>

{% set sec.n = sec.n + 1 %}<h2 id="findings-overview">{{ sec.n }}. Findings overview</h2>
<table class="overview-sev-summary">
  <tr>
    {% for s in severities %}
    <th><span class="sev sev-{{ s }}">{{ s|severity_label }}</span></th>
    {% endfor %}
  </tr>
  <tr>
    {% for s in severities %}
    <td>{{ by_sev.get(s, 0) }}</td>
    {% endfor %}
  </tr>
</table>
{% if findings|length >= 25 %}
<p class="meta">{{ findings|length }} findings listed below; details in Detailed findings.</p>
{% endif %}
<table class="overview-table">
  <tr><th>ID</th><th>Title</th><th>Severity</th><th>Status</th><th>Retest result</th><th>Asset</th></tr>
  {% for f in findings %}
  {% set rt = latest_retest(f.id) %}
  <tr>
    <td class="mono">{{ flabel(f) }}</td>
    <td>{{ f.title|truncate(90, True, '…') }}</td>
    <td><span class="sev sev-{{ f.severity }}">{{ f.severity|severity_label }}</span></td>
    <td>{{ f.status|status_label }}</td>
    <td>{% if rt %}{{ (rt.result or "requested")|status_label }}{% if rt.finalized_at %} ({{ rt.finalized_at|format_date }}){% endif %}{% else %}—{% endif %}</td>
    <td class="mono">{% if f.asset %}{{ f.asset.identifier|truncate(40, True, '…') }}{% else %}—{% endif %}</td>
  </tr>
  {% else %}<tr><td colspan="6">No findings.</td></tr>{% endfor %}
</table>

{% if passed_checks %}
{% set sec.n = sec.n + 1 %}<h2 id="status-checks">{{ sec.n }}. Status checks</h2>
<p class="meta">Checks that ran clean (green) sit next to checks that failed. Skipped means the check was not run for this target.</p>
<table class="status-checks-table">
  <tr><th>Check</th><th>Result</th><th>Source</th><th>Evidence</th></tr>
  {% for c in passed_checks %}
  <tr>
    <td>{{ c.name|check_label }}</td>
    <td>{% if c.status == "passed" %}<span class="status-passed">Passed</span>{% elif c.status == "failed" %}<span class="status-failed">Failed</span>{% else %}<span class="meta">Skipped</span>{% endif %}</td>
    <td>{{ c.source|tool_label }}</td>
    <td class="mono">{{ c.evidence or "—" }}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}

{% if security_testing_coverage %}
{% set sec.n = sec.n + 1 %}<h2 id="security-testing-coverage">{{ sec.n }}. Security testing coverage</h2>
<p class="meta">Coverage is tracked separately from vulnerability counts. Skipped and blocked checks are not counted as passed. Scan completion is not the same as security testing coverage.</p>
{% if security_testing_coverage.exclusions_note %}
<p class="meta">{{ security_testing_coverage.exclusions_note }}</p>
{% endif %}
<table>
  <tr><th>Measure</th><th>Count</th></tr>
  <tr><td>Endpoints discovered</td><td>{{ security_testing_coverage.endpoints_discovered }}</td></tr>
  <tr><td>Endpoints tested</td><td>{{ security_testing_coverage.endpoints_tested }}</td></tr>
  <tr><td>Endpoints untested</td><td>{{ security_testing_coverage.endpoints_untested }}</td></tr>
  <tr><td>Checklist passed</td><td>{{ security_testing_coverage.checklist_passed }}</td></tr>
  <tr><td>Checklist failed</td><td>{{ security_testing_coverage.checklist_failed }}</td></tr>
  <tr><td>Checklist blocked</td><td>{{ security_testing_coverage.checklist_blocked }}</td></tr>
  <tr><td>Checklist not started</td><td>{{ security_testing_coverage.checklist_not_started }}</td></tr>
  <tr><td>Automated cases successful</td><td>{{ security_testing_coverage.automated_cases_successful }}</td></tr>
  <tr><td>Automated cases failed</td><td>{{ security_testing_coverage.automated_cases_failed }}</td></tr>
  <tr><td>Automated cases skipped</td><td>{{ security_testing_coverage.automated_cases_skipped }}</td></tr>
</table>
{% endif %}

{% if automated_coverage_limitations and automated_coverage_limitations.section %}
{% set sec.n = sec.n + 1 %}<h2 id="automated-coverage-limitations">{{ sec.n }}. Automated coverage and limitations</h2>
<p class="meta">What the automated catalogue deferred, skipped, or blocked — including mid-scan authentication loss. These rows are never treated as passed.</p>
{% if automated_coverage_limitations.auth_notes %}
<p><b>Authentication notes.</b></p>
<ul>
  {% for note in automated_coverage_limitations.auth_notes %}
  <li class="meta">{{ note }}</li>
  {% endfor %}
</ul>
{% endif %}
{% if automated_coverage_limitations.cases %}
<table>
  <tr><th>Run</th><th>Case</th><th>Status</th><th>Skip reason</th><th>Detail</th></tr>
  {% for c in automated_coverage_limitations.cases %}
  <tr>
    <td class="mono">#{{ c.execution_id }}</td>
    <td class="mono">{{ c.test_id }}</td>
    <td>{{ (c.status or "—")|status_label }}</td>
    <td class="mono">{{ c.skip_reason or "—" }}</td>
    <td>{{ c.detail or "—" }}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}
{% if automated_coverage_limitations.deferred %}
<p><b>Deferred catalogue capabilities.</b> Not claimed as covered by this engagement's automated runs:</p>
<table>
  <tr><th>Category</th><th>Capability</th><th>Notes</th></tr>
  {% for d in automated_coverage_limitations.deferred %}
  <tr>
    <td>{{ d.category or "—" }}</td>
    <td>{{ d.capability or "—" }}</td>
    <td class="meta">{{ d.notes or "—" }}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}
{% endif %}

{% if auth_checklist_section %}
{% set sec.n = sec.n + 1 %}<h2 id="auth-checklist">{{ sec.n }}. Authenticated security testing checklist</h2>
<p class="meta">Only executed checklist items are listed (passed, failed, blocked). Skipped and blocked items are not treated as passed.</p>
{% if auth_coverage and auth_coverage.exclusions_note %}
<p class="meta">{{ auth_coverage.exclusions_note }}</p>
{% endif %}
{% if auth_checklist %}
<table>
  <tr><th>Ref</th><th>Title</th><th>Status</th><th>Notes</th></tr>
  {% for item in auth_checklist %}
  <tr>
    <td class="mono">{{ item.ref }}</td>
    <td>{{ item.title }}</td>
    <td>{% if item.status in ("passed", "pass") %}<span class="status-passed">Passed</span>{% elif item.status in ("failed", "fail") %}<span class="status-failed">Failed</span>{% else %}<span class="meta">{{ item.status|status_label }}</span>{% endif %}</td>
    <td>{{ (item.notes or "—")|format_checklist_note if item.notes else "—" }}</td>
  </tr>
  {% endfor %}
</table>
{% else %}
<p class="meta">No checklist items have been executed yet.</p>
{% endif %}
{% endif %}

{% if site_grades %}
{% set sec.n = sec.n + 1 %}<h2 id="site-grades">{{ sec.n }}. Site grades</h2>
{# Intro kept short and separate from the table so xhtml2pdf can split rows across pages. #}
<div class="site-grades-intro">
  <p class="meta">Each target starts at 100. Penalties subtract for missing or weak controls; bonuses apply only when the running score is already 90 or higher.</p>
  <p class="meta">Not-tested checks leave the score unchanged. False positives are ignored; accepted-risk findings still count.</p>
  <p class="meta">The final number maps to a letter grade (for example, score 50 → C). The table lists each check, result, points, and reason.</p>
</div>
{% for g in site_grades %}
  <h3>{{ g.identifier }} — <b>{{ g.grade }}</b> (score {{ g.score }})</h3>
  <table class="site-grades">
    <thead>
      <tr><th>Check</th><th>Result</th><th>Points</th><th>Reason</th></tr>
    </thead>
    <tbody>
    {% for row in g.breakdown if row.result != "not_tested" %}
    <tr>
      <td>{{ row.check|check_label }}</td>
      <td>{% if row.result in ("pass", "passed") %}<span class="status-passed">Passed</span>{% elif row.result in ("fail", "failed") %}<span class="status-failed">Failed</span>{% else %}{{ row.result|status_label }}{% endif %}</td>
      <td>{% if row.points > 0 %}+{{ row.points }}{% else %}{{ row.points }}{% endif %}</td>
      <td>{{ row.reason }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
{% endfor %}
{% endif %}

{% if tls_summaries %}
{% set sec.n = sec.n + 1 %}<h2 id="tls">{{ sec.n }}. TLS summary</h2>
<p class="meta">Protocols, ciphers, certificate and OCSP from the latest testssl result for each target.</p>
{% for t in tls_summaries %}
  <table>
    <tr><th style="width:180px">Target</th><td class="mono">{{ t.asset or t.host }}</td></tr>
    <tr><th>Protocols</th><td>{{ t.protocols|join("; ") }}</td></tr>
    <tr><th>Best cipher</th><td class="mono">{{ t.best_cipher }}</td></tr>
    <tr><th>Weakest cipher</th><td class="mono">{{ t.weakest_cipher }}</td></tr>
    <tr><th>Certificate expiry</th><td>{{ t.cert_expiry }}{% if t.days_left is defined and t.days_left is not none %} ({{ t.days_left }} days left){% endif %}</td></tr>
    <tr><th>Chain of trust</th><td>{{ t.chain_ok }}</td></tr>
    <tr><th>Certificate signature</th><td class="mono">{{ t.cert_signature }}</td></tr>
    <tr><th>Handshake signatures</th><td class="mono">{{ t.handshake_signatures }}</td></tr>
    <tr><th>OCSP</th><td>{{ t.ocsp }}</td></tr>
  </table>
{% endfor %}
{% endif %}

{% set sec.n = sec.n + 1 %}<h2 id="findings">{{ sec.n }}. Detailed findings</h2>
{% for f in findings %}
<div class="finding finding-{{ f.severity }}" id="finding-{{ f.id }}">
  <div class="finding-head">
    <h3><a name="finding-{{ f.id }}"></a>{{ flabel(f) }} · {{ f.title }}</h3>
    <div class="finding-header">
      <span class="sev sev-{{ f.severity }}">{{ f.severity|severity_label }}</span>
      · Status: <b>{{ f.status|status_label }}</b>
      {% set vlabel = f.validation_status_label if f.validation_status_label is defined and f.validation_status_label else (f.validation_status|status_label if f.validation_status is defined and f.validation_status else "Unvalidated") %}
      · Validation: <b>{{ vlabel }}</b>
      · Priority / Business risk {{ "%.1f"|format(f.risk_score) }}{% if f.business_risk %} ({{ f.business_risk|severity_label }}){% endif %}
      · Fix by {% if f.sla_due %}{{ f.sla_due|format_date }}{% else %}—{% endif %}
      {% if f.asset and (effective_exposure(f.asset) if effective_exposure is defined else f.asset.exposure) == "internet" %} · <span class="sev chip-internet">Internet-facing</span>{% endif %}
    </div>
    {% if f.cvss_score is not none or f.cvss_vector or f.epss is not none or f.kev or f.business_risk %}
    <table class="finding-meta">
      {% set cvss_ver = f.cvss_version if f.cvss_version else (finding_cvss_version(f) if finding_cvss_version is defined else (f.cvss_vector.split('/')[0].split(':')[1] if f.cvss_vector and f.cvss_vector.startswith('CVSS:') else '')) %}
      {% if f.cvss_score is not none %}<tr><th>CVSS score{% if cvss_ver %} (v{{ cvss_ver }}){% endif %}</th><td>{{ f.cvss_score }}</td></tr>{% elif cvss_ver %}<tr><th>CVSS version</th><td>v{{ cvss_ver }}</td></tr>{% endif %}
      {% if f.cvss_vector %}<tr><th>CVSS version / vector</th><td>{% if cvss_ver %}v{{ cvss_ver }} · {% endif %}<span class="mono">{{ f.cvss_vector }}</span></td></tr>{% endif %}
      {% if f.business_risk %}<tr><th>Priority / Business risk</th><td>{{ f.business_risk|severity_label }} (score {{ "%.1f"|format(f.risk_score) }})</td></tr>{% endif %}
      {% if f.epss is not none %}<tr><th>EPSS</th><td>{{ "%.3f"|format(f.epss) }}</td></tr>{% endif %}
      {% if f.kev %}<tr><th>KEV</th><td><b>CISA KEV</b></td></tr>{% endif %}
    </table>
    {% endif %}
    {% set rt = latest_retest(f.id) %}
    {% if rt %}
    <p class="meta">Latest retest: {{ rt.result or "requested" }}{% if rt.note %} — {{ rt.note }}{% endif %}{% if rt.finalized_at %} ({{ rt.finalized_at.strftime('%Y-%m-%d') }} by {{ rt.finalized_by }}){% endif %}</p>
    {% endif %}
  </div>
  {% if f.asset or f.location or f.affected_urls %}
  <div class="finding-section">
    {% if f.asset %}
    <p><b>Affected asset.</b> <span class="mono">{{ f.asset.identifier }}</span>{% if f.asset.name %} ({{ f.asset.name }}){% endif %}</p>
    {% endif %}
    {% if f.location %}
    <p><b>Affected endpoint.</b> <span class="mono">{{ f.location|param_label }}</span></p>
    {% endif %}
    {% if f.affected_urls %}
    <p><b>Affected URLs.</b>{% if f.affected_urls is not string %} ({{ f.affected_urls|length }}){% endif %}</p>
    <ul class="mono">{% if f.affected_urls is string %}<li>{{ f.affected_urls|param_label }}</li>{% else %}{% for u in f.affected_urls %}<li>{{ u|param_label }}</li>{% endfor %}{% endif %}</ul>
    {% endif %}
  </div>
  {% endif %}
  {% if f.description %}<div class="finding-section"><p><b>Description.</b> {{ f.description|param_label }}</p></div>{% endif %}
  {% if f.reproduction_steps is defined and f.reproduction_steps %}
  <div class="finding-section">
    <p><b>Reproduction steps.</b></p>
    <p style="white-space:pre-wrap">{{ f.reproduction_steps|param_label }}</p>
  </div>
  {% endif %}
  {% if f.impact %}<div class="finding-section"><p><b>Impact.</b> {{ f.impact|param_label }}</p></div>{% endif %}
  {% set rem = f.remediation_pack if f.remediation_pack is defined else none %}
  {% if rem is none and remediation_by_id is defined %}
    {% set rem = remediation_by_id.get(f.id) %}
  {% endif %}
  {% if rem and rem.root_cause %}
  <div class="finding-section">
    <p><b>Root cause.</b></p>
    <p>{{ rem.root_cause|param_label }}</p>
  </div>
  {% endif %}
  {% if f.recommendation %}
  <div class="finding-section">
    <p><b>Remediation.</b></p>
    {% set rec_bullets = recommendation_to_bullets(f.recommendation) %}
    {% if rec_bullets %}{{ rec_bullets|safe }}{% else %}<p>{{ f.recommendation|param_label }}</p>{% endif %}
  </div>
  {% endif %}
  {% if rem and (rem.recommended_fix or rem.verification_steps or rem.retest_instructions or rem.compatibility) %}
  <div class="finding-section">
    {% if rem.recommended_fix %}
    <p><b>Recommended fix.</b></p>
    {% set rem_fix_bullets = recommendation_to_bullets(rem.recommended_fix) %}
    {% if rem_fix_bullets %}{{ rem_fix_bullets|safe }}{% else %}<p>{{ rem.recommended_fix|param_label }}</p>{% endif %}
    {% endif %}
    {% if rem.verification_steps %}
    <p><b>Verification.</b></p>
    <p style="white-space:pre-wrap">{{ rem.verification_steps|param_label }}</p>
    {% endif %}
    {% if rem.retest_instructions %}
    <p><b>Retest.</b></p>
    <p>{{ rem.retest_instructions|param_label }}</p>
    {% endif %}
    {% if rem.compatibility %}
    <p class="meta"><b>Compatibility.</b> {{ rem.compatibility|param_label }}</p>
    {% endif %}
  </div>
  {% endif %}
  {% set fix = fix_by_id.get(f.id) if fix_by_id is defined else none %}
  {% if fix %}
  <div class="finding-section">
  <p><b>How to fix.</b>
    {% if fix.importance %}Importance: {{ fix.importance }}.{% endif %}
    {% if fix.effort %} Effort: {{ fix.effort }}.{% endif %}
  </p>
  {% if fix.fix_steps %}
    {% set fix_bullets = recommendation_to_bullets(fix.fix_steps) %}
    {% if fix_bullets %}{{ fix_bullets|safe }}{% else %}<p style="white-space:pre-wrap">{{ fix.fix_steps }}</p>{% endif %}
  {% endif %}
  {% set snips = report_snippets_by_id.get(f.id, []) if report_snippets_by_id is defined else [] %}
  {% for name, text in snips %}
  <p><b>{{ name|words_title }} config.</b></p>
  <pre class="mono" style="white-space:pre-wrap">{{ text }}</pre>
  {% endfor %}
  </div>
  {% endif %}
  {% if f.references %}
  <div class="finding-section">
  <p><b>References.</b></p>
  <ul>{% if f.references is string %}<li>{{ f.references }}</li>{% else %}{% for ref in f.references %}<li>{{ ref }}</li>{% endfor %}{% endif %}</ul>
  </div>
  {% endif %}
  <div class="finding-section">
    <p><b>Validation status.</b> {{ vlabel }}{% if f.validation_reasons is defined and f.validation_reasons %} — {{ f.validation_reasons|join("; ") }}{% endif %}</p>
  </div>
  {% if ai_narratives and ai_narratives.get(f.id) %}<div class="finding-section"><p><b>Narrative.</b> {{ ai_narratives[f.id].text }} <span class="meta">(AI-assisted, approved by {{ ai_narratives[f.id].approved_by }})</span></p></div>{% endif %}
  {% set obs = observations_by_finding.get(f.id, []) if observations_by_finding is defined else [] %}
  {% if obs %}
  <div class="finding-section">
  <p><b>Scanner observations.</b></p>
  <ul>{% for o in obs %}<li>{{ o.tool|tool_label }}{% if o.original_id %} · {{ o.original_id }}{% endif %}{% if o.location %} · <span class="mono">{{ o.location|param_label }}</span>{% endif %}{% if o.evidence_refs %} &middot; <span class="mono">{{ o.evidence_refs|join(" | ")|truncate(300) }}</span>{% endif %}{% if o.match_rationale %} · {{ o.match_rationale|dedup_label }}{% endif %}</li>{% endfor %}</ul>
  </div>
  {% endif %}
  {% if f.cross_sources is defined and f.cross_sources|length > 1 %}
  <div class="finding-section">
  <p><b>Sources.</b> ({{ f.cross_sources|length }})</p>
  <ul>{% for src in f.cross_sources %}<li>{{ src.tool_label }}: {{ src.severity_label }} &middot; {{ src.title }} &middot; {{ src.status_label }}{% if src.location %} &middot; <span class="mono">{{ src.location|param_label }}</span>{% endif %}{% if src.evidence %} &middot; <span class="mono">{{ src.evidence|join(" | ")|param_label|truncate(300) }}</span>{% endif %}</li>{% endfor %}</ul>
  </div>
  {% endif %}
  <p class="finding-refs-label">Technical details</p>
  <table class="finding-refs">
    <tr><th>Location</th><td class="mono">{{ f.location|param_label }}{% if f.affected_urls and f.affected_urls is not string and f.affected_urls|length > 1 %} ({{ f.affected_urls|length }} affected URLs, listed above){% endif %}</td></tr>
    {% if f.cwe %}<tr><th>CWE</th><td>CWE-{{ f.cwe }}</td></tr>{% endif %}
    {% if f.cves %}<tr><th>CVE</th><td>{{ f.cves|join(", ") }}</td></tr>{% endif %}
    {% if f.owasp_top10 %}<tr><th>OWASP Top 10</th><td>{{ f.owasp_top10 }}</td></tr>{% endif %}
    {% if f.asvs_ref %}<tr><th>ASVS</th><td>{{ f.asvs_ref }}</td></tr>{% endif %}
    {% if f.wstg_ref %}<tr><th>WSTG</th><td>{{ f.wstg_ref }}</td></tr>{% endif %}
    <tr><th>Detected by</th><td>{% for t in f.tools %}{{ t|tool_label }}{% if not loop.last %}, {% endif %}{% else %}—{% endfor %} ({{ plural(f.occurrences, "observation") }})</td></tr>
    {% if f.cross_sources is defined and f.cross_sources|length > 1 %}<tr><th>Severity by tool</th><td>{{ f.severity_label }}</td></tr>{% endif %}
    {% if f.issues_covered is defined and f.issues_covered %}<tr><th>Issues covered</th><td>{{ f.issues_covered|join("; ") }}</td></tr>{% endif %}
    {% if f.report_merge_rationale is defined and f.report_merge_rationale %}<tr><th>Consolidated</th><td class="meta">{{ f.report_merge_rationale|consolidate_sentence }}</td></tr>{% endif %}
    {% if f.dedup_rationale %}<tr><th>Deduplication</th><td class="meta">{{ f.dedup_rationale|dedup_label }}{% if f.dedup_confidence is not none %} ({{ '%.2f'|format(f.dedup_confidence) }}){% endif %}</td></tr>{% endif %}
    {% if f.validated_by %}<tr><th>Validated by</th><td>{{ f.validated_by }}</td></tr>{% endif %}
    <tr><th>Validation status</th><td>{{ vlabel }}</td></tr>
    <tr><th>Control objectives</th><td>{{ objectives_for(f)|join(", ") }}</td></tr>
  </table>
  {% set embeds = evidence_embeds.get(f.id, []) %}
  {% set pairs = http_pairs.get(f.id, []) if http_pairs is defined else [] %}
  {% set limits = evidence_limitations.get(f.id, []) if evidence_limitations is defined else [] %}
  {% if embeds or pairs or limits or f.evidence %}
  <div class="finding-evidence">
  {% if embeds %}
  <p><b>Evidence (screenshots).</b></p>
  {% for e in embeds %}
  <figure class="evidence-figure" id="fig-F-{{ f.id }}-{{ loop.index }}"><a name="fig-F-{{ f.id }}-{{ loop.index }}"></a>
    {% if e.data_uri %}<img class="evidence-img" src="{{ e.data_uri }}" alt="{{ e.caption or e.filename }}">{% endif %}
    <figcaption class="fig-caption">Fig. {{ flabel(f) }}-{{ loop.index }}: {{ e.caption or e.note or e.filename }} · sha256 {{ e.sha256 }}{% if e.missing %} (file missing){% endif %}</figcaption>
  </figure>
  {% endfor %}
  {% endif %}
  {% if pairs %}
  <p><b>Evidence (HTTP request/response).</b></p>
  {# Consolidated findings carry one pair per merged scanner row; show two representative
     pairs and point to the hashed register instead of repeating near-identical dumps. #}
  {% for p in pairs[:2] %}
  <pre class="http-pair mono">{{ p.display }}</pre>
  {% endfor %}
  {% if pairs|length > 2 %}<p class="meta">{{ pairs|length - 2 }} more HTTP request/response pair{{ "s" if pairs|length - 2 != 1 }} for this issue are listed (with SHA-256) in the evidence register below.</p>{% endif %}
  {% endif %}
  {% if limits %}
  <p><b>Evidence capture limitations.</b></p>
  <ul>{% for note in limits %}<li>{{ note }}</li>{% endfor %}</ul>
  <p class="meta">No screenshot was fabricated. Other available evidence is listed below.</p>
  {% endif %}
  {% if f.evidence %}<p><b>Evidence register.</b></p><ul>{% for e in f.evidence %}<li>{{ e.kind|evidence_kind_label }}{% if e.role and e.role != "original" %} ({{ e.role|humanize }}){% endif %}: {{ e.filename }} <span class="mono">sha256 {{ e.sha256 }}</span>{% if e.source_tool %} · {{ e.source_tool|tool_label }}{% endif %}{% if e.note %} · {{ e.note|evidence_note_label }}{% endif %}</li>{% endfor %}</ul>{% endif %}
  </div>
  {% endif %}
  {% if include_comments and comments_by_finding.get(f.id) %}
  <p><b>Comments.</b></p>
  <ul>{% for c in comments_by_finding[f.id] %}<li style="white-space:pre-wrap">{{ c.body }}</li>{% endfor %}</ul>
  {% endif %}
</div>
{% else %}
<p>No findings.</p>
{% endfor %}

{% if automated_runs is defined and automated_runs %}
{% set sec.n = sec.n + 1 %}<h2 id="automated-testing-evidence">{{ sec.n }}. Automated testing evidence</h2>
<p class="meta">Automated security test runs on this engagement. Every case is listed below; evidence images (two-panel HTTP visuals and browser screenshots) are included only for failed or finding results. Passed captures remain on the engagement page.</p>
{% for run in automated_runs %}
<div class="finding">
<h3>Run #{{ run.id }}: <span class="mono">{{ run.target }}</span></h3>
<p class="meta">{{ automated_run_header(status=run.status, profile=run.profile, finished_at=run.ended_at, case_count=run.cases|length, image_count=run.image_count) }}</p>
{% if run.error %}<p><b>Run error.</b> {{ run.error|format_detail_sentence }}</p>{% endif %}
{% if run.cases %}
<table>
  <tr><th>Test</th><th>Status</th><th>Detail</th></tr>
  {% for c in run.cases %}
  <tr><td>{{ test_name_label(c.test_id, c.title) }}</td><td>{{ c.status|status_label }}{% if c.validation_status %} ({{ c.validation_status|status_label }}){% endif %}{% if c.finding_id %} · {{ flabel(c.finding_id) }}{% endif %}</td><td>{{ (c.detail or "")|format_detail_sentence }}</td></tr>
  {% endfor %}
</table>
{% endif %}
{% for c in run.cases %}
{% for ev in c.evidence %}
<figure>
  <img class="evidence-img" src="{{ ev.data_uri }}" alt="{{ c.test_id }} {{ ev.label }}">
  <figcaption class="fig-caption">Fig. AT-{{ run.id }}-{{ c.test_id }}-{{ loop.index }}: {{ c.test_id }} {{ c.status|status_label }} · {{ ev.label }} · sha256 {{ ev.sha256 }}</figcaption>
</figure>
{% endfor %}
{% endfor %}
</div>
{% endfor %}
{% endif %}

{% set sec.n = sec.n + 1 %}<h2 id="disclaimer">{{ sec.n }}. Assumptions, limitations and confidentiality</h2>
<p>{{ disclaimer }}</p>
<div id="testing-limitations">
<p><b>Testing limitations (honesty).</b></p>
<ul>
  <li>Skipped or blocked checklist items are <em>not</em> passed. Incomplete coverage must not be read as a clean result.</li>
  <li>Scan completion is <em>not</em> the same as security testing coverage. Finishing an automated scan does not imply every relevant case, endpoint, role, or business workflow was tested.</li>
  <li>Unvalidated scanner alerts are <em>not</em> confirmed vulnerabilities. A finding remains unconfirmed until a named tester validates it with evidence (or classifies it otherwise).</li>
  <li>Failed or incomplete scans are not evidence of absence of vulnerabilities.</li>
</ul>
</div>
<div id="assumptions">
<p><b>Assumptions.</b> Testing was performed within the authorized scope, window, and environments recorded above. Out-of-scope systems, credentials not provided, rate limits, WAF blocks, and environment unavailability may leave gaps that are reflected as skipped, blocked, or untested — never as passed.</p>
</div>
<p class="meta">Copyright and distribution: this report is confidential to {{ tenant }} and authorized recipients. Do not redistribute without client approval.</p>

{% set sec.n = sec.n + 1 %}<h2 id="retesting">{{ sec.n }}. Retesting information</h2>
{% if retest_requests %}
<p class="meta">Retest requests recorded on this engagement (newest first). Finalized results also appear on individual finding cards.</p>
<table>
  <tr><th>Finding</th><th>Result</th><th>Requested by</th><th>Requested</th><th>Finalized</th><th>Note</th></tr>
  {% for rt in retest_requests %}
  <tr>
    <td class="mono"><a href="#finding-{{ rt.finding_id }}">{{ rt.finding_label }}</a></td>
    <td>{{ (rt.result or "requested")|status_label }}{% if rt.asset_reached %} · asset reached{% endif %}</td>
    <td>{{ rt.requested_by or "—" }}</td>
    <td>{{ rt.created_at|format_date if rt.created_at else "—" }}</td>
    <td>{% if rt.finalized_at %}{{ rt.finalized_at|format_date }}{% if rt.finalized_by %} by {{ rt.finalized_by }}{% endif %}{% else %}—{% endif %}</td>
    <td>{{ rt.note or "—" }}</td>
  </tr>
  {% endfor %}
</table>
{% else %}
<p>No retest requests are recorded on this engagement yet. After remediation, request a retest from the engagement findings view or the client portal (with a note). Staff finalize the retest against a scan that reached the affected asset; a finding is marked fixed only when that reachability check passes. Until then, prior evidence remains unchanged.</p>
{% endif %}

{% set sec.n = sec.n + 1 %}<h2 id="conclusion">{{ sec.n }}. Conclusion</h2>
<p>This {{ type_label }} engagement identified {{ plural(findings|length, "reportable finding") }}
({% for s in severities %}{{ by_sev.get(s, 0) }} {{ s|severity_label }}{% if not loop.last %}, {% endif %}{% endfor %} open vulnerabilities at generation time; {{ plural(false_positives, "false positive") }} excluded{% if informational_open %}; {{ informational_open }} informational or not-reproducible observation{{ "s" if informational_open != 1 else "" }} excluded from open-vuln counts{% endif %}).
Remediate Critical and High issues first, then retest. Control statuses in any compliance pack remain proposals until a named assessor confirms them. Informational validation observations are not confirmed vulnerabilities.</p>

{% set sec.n = sec.n + 1 %}<h2 id="sign-off">{{ sec.n }}. Sign-off / QA and approval</h2>
<p class="meta">This sealed generation is a <b>DRAFT</b>: QA reviewer and Approved / signed rows use explicit pending placeholders. Prior document-control rows show recorded QA and signer names when a previous version completed the workflow. Live status, hash check and signature validity appear in the Attestra sign-off record when you open the report in the product; the sealed file below stays unchanged.</p>
{% if ca and ca.authorization_statement %}<p class="meta">{{ ca.authorization_statement }}</p>{% endif %}
<table>
  <tr><th>Role</th><th>Name</th><th>Date</th><th>Signature / mark</th></tr>
  <tr>
    <td>Author</td>
    <td>{{ generated_by }}</td>
    <td>{{ generated_at|format_date }}</td>
    <td>Generated (DRAFT)</td>
  </tr>
  <tr>
    <td>QA reviewer</td>
    <td>Pending QA (DRAFT)</td>
    <td>—</td>
    <td>Pending QA (DRAFT)</td>
  </tr>
  <tr>
    <td>Approved / signed</td>
    <td>{% if ca and ca.signer_name %}{{ ca.signer_name }}{% if ca.signer_title %}, {{ ca.signer_title }}{% endif %} <span class="meta">(placeholder until signed)</span>{% else %}Pending approval (DRAFT){% endif %}</td>
    <td>—</td>
    <td>{% if ca and ca.legal_name %}{{ ca.legal_name }} <span class="meta">(pending signature)</span>{% else %}Pending approval (DRAFT){% endif %}</td>
  </tr>
</table>

<p class="meta platform-attestation" id="platform-attestation">This report was generated by the Attestra VAPT testing platform.</p>

{% set sec.n = sec.n + 1 %}<h2 id="appendix">{{ sec.n }}. Appendix</h2>
<p class="meta">Tool imports and scan runs that contributed evidence to this report. Failed or incomplete scans are not evidence of absence of vulnerabilities.</p>
<h3>A. Tool imports</h3>
<table class="appendix-table">
  <tr><th>#</th><th>Tool</th><th>File</th><th>Imported</th><th>New / merged</th><th>SHA-256 (raw)</th></tr>
  {% for i in imports %}
  <tr><td>{{ i.id }}</td><td>{{ i.tool|tool_label }}</td><td>{{ i.filename }}</td><td>{{ i.imported_at|format_date }} by {{ i.imported_by }}</td><td>{{ i.new_findings }} / {{ i.updated_findings }}</td><td class="mono">{{ i.sha256 }}</td></tr>
  {% else %}<tr><td colspan="6">No results imported.</td></tr>{% endfor %}
</table>
{% if scan_history %}
<h3>B. Scan runs</h3>
<table class="appendix-table">
  <tr><th>Scan</th><th>Tool</th><th>Status</th><th>Started</th><th>Ended</th><th>Refusal Reason</th></tr>
  {% for run in scan_history[:20] %}
  <tr>
    <td>{{ run.id }}</td>
    <td>{{ run.tool|tool_label }}</td>
    <td>{{ run.status|status_label }}</td>
    <td>{{ run.started_at|format_datetime if run.started_at else "—" }}</td>
    <td>{{ run.ended_at|format_datetime if run.ended_at else "—" }}</td>
    <td>{{ run.refuse_reason or "—" }}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}
<p class="meta">Attestra {{ version_str }} · Engagement #{{ eng.id }} · Report v{{ version }}.</p>
{% endblock %}
