{% extends "_base.html.j2" %}
{% block title %}Attestation letter{% endblock %}
{% block body %}
<h1>Attestation letter</h1>
<div class="meta">{{ tenant }} · {{ eng.name }} · {{ today }}</div>

<p>{{ ca.legal_name if ca and ca.legal_name else "Attestra" }} records that security testing activities for
<strong>{{ eng.name }}</strong> ({{ type_label }}) were performed under a
signed client authorization covering the approved environments for this engagement.</p>
{% if ca and ca.authorization_statement %}
<p>{{ ca.authorization_statement }}</p>
{% endif %}

<p>This attestation does <strong>not</strong> list individual vulnerabilities,
proof-of-concept details, or remediation guidance. Those appear only in the
technical report under dual-control approval.</p>

<table>
  <tr><th>Item</th><th>Value</th></tr>
  <tr><td>Client</td><td>{{ tenant }}</td></tr>
  <tr><td>Engagement</td><td>{{ eng.name }}</td></tr>
  <tr><td>Frameworks in scope</td><td>{{ eng.frameworks|join(", ") or "n/a" }}</td></tr>
  <tr><td>Authorizations on file</td><td>{{ authorizations|length }}</td></tr>
  <tr><td>Open critical/high (count only)</td><td>{{ open_critical_high }}</td></tr>
</table>

{% if safe_to_host %}
<section id="safe-to-host" class="safe-to-host">
  <h2>Safe-to-Host statement</h2>
  <p>This Safe-to-Host style statement summarizes the security testing posture for
  <strong>{{ safe_to_host_client or tenant }}</strong> under engagement
  <strong>{{ safe_to_host_engagement or eng.name }}</strong>. It is intended to
  support the client's own hosting or go-live decision. It is
  <strong>not</strong> a compliance certification, audit opinion, or guarantee
  that systems are free of risk.</p>
  <table>
    <tr><th>Item</th><th>Value</th></tr>
    <tr><td>Client</td><td>{{ safe_to_host_client or tenant }}</td></tr>
    <tr><td>Engagement</td><td>{{ safe_to_host_engagement or eng.name }}</td></tr>
    <tr><td>Signed authorization on file</td><td>{{ "Yes" if safe_to_host_authorization_present else "No" }}</td></tr>
    <tr><td>Approved environments</td><td>{{ (safe_to_host_environments or [])|join(", ") or "n/a" }}</td></tr>
    <tr><td>Open critical/high findings (count only)</td><td>{{ safe_to_host_open_critical_high if safe_to_host_open_critical_high is defined else open_critical_high }}</td></tr>
  </table>
  <p>Any decision to host, promote, or go live remains solely with the client.
  Absence of open critical or high findings does not prove that controls are
  effective. This letter records security testing under the stated authorization
  and scope; it does not certify compliance with any regulatory framework.</p>
</section>
{% endif %}

{% if ca and (ca.signer_name or ca.signer_title or ca.address_formatted or ca.contact_email) %}
<table>
  <tr><th>Item</th><th>Value</th></tr>
  {% if ca.legal_name %}<tr><td>Certification Authority</td><td>{{ ca.legal_name }}</td></tr>{% endif %}
  {% if ca.signer_name %}<tr><td>Authorized signer</td><td>{{ ca.signer_name }}{% if ca.signer_title %}, {{ ca.signer_title }}{% endif %}</td></tr>{% endif %}
  {% if ca.address_formatted %}<tr><td>Address</td><td>{{ ca.address_formatted }}</td></tr>{% endif %}
  {% if ca.contact_email %}<tr><td>Email</td><td>{{ ca.contact_email }}</td></tr>{% endif %}
  {% if ca.contact_phone %}<tr><td>Phone</td><td>{{ ca.contact_phone }}</td></tr>{% endif %}
  {% if ca.website %}<tr><td>Website</td><td>{{ ca.website }}</td></tr>{% endif %}
</table>
{% endif %}
<p>Prepared by {{ generated_by }} on {{ generated_at }}.</p>
{% endblock %}
