{% extends "_base.html.j2" %}
{% block title %}Engagement closure letter{% endblock %}
{% block body %}
<h1>Engagement closure letter</h1>
<div class="meta">{{ tenant }} · {{ eng.name }} · {{ today }}</div>

<p>Dear {{ eng.tenant.contact_name or "Client" }},</p>

<p>This letter confirms that the {{ type_label }} engagement
<strong>{{ eng.name }}</strong> for <strong>{{ tenant }}</strong>
(window {{ eng.window_start or "n/a" }} to {{ eng.window_end or "n/a" }}) has been closed
from Attestra's delivery perspective.</p>

<p>Summary without vulnerability detail:</p>
<ul>
  <li>Open findings remaining: {{ open_findings|length }}</li>
  <li>Open critical/high: {{ open_critical_high }}</li>
  <li>False positives recorded: {{ false_positives }}</li>
  <li>Import runs: {{ imports|length }}</li>
</ul>

<p>Detailed technical findings are provided only in the separately controlled technical report.
This letter intentionally omits vulnerability specifics.</p>

<p>Generated by {{ generated_by }} on {{ generated_at }} (Attestra {{ version_str }}).</p>
{% endblock %}
