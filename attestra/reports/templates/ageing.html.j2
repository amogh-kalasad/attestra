{% extends "_base.html.j2" %}
{% block title %}Finding ageing and SLA breaches{% endblock %}
{% block body %}
<h1>Ageing and SLA breaches</h1>
<div class="meta">{{ eng.name|words_title }} · {{ tenant }} · generated {{ generated_at|format_date }} by {{ generated_by }}</div>

<p class="note">Open findings past their severity SLA due date (Critical 30d, High 60d, Medium 90d, Low 180d).</p>

{% if sla_breaches %}
<table>
  <tr><th>ID</th><th>Severity</th><th>Title</th><th>Status</th><th>SLA due</th><th>First seen</th></tr>
  {% for f in sla_breaches %}
  <tr>
    <td>{{ flabel(f) }}</td>
    <td><span class="sev sev-{{ f.severity }}">{{ f.severity|severity_label }}</span></td>
    <td>{{ f.title }}</td>
    <td>{{ f.status|status_label }}</td>
    <td>{{ f.sla_due|format_date if f.sla_due else "" }}</td>
    <td>{{ f.first_seen|format_date if f.first_seen else "" }}</td>
  </tr>
  {% endfor %}
</table>
{% else %}
<p class="meta">No open findings are past their SLA due date.</p>
{% endif %}
{% endblock %}
