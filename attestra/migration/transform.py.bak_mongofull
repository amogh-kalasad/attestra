"""Transform SQLAlchemy/SQL rows into MongoDB documents (preserve ids & types)."""

from __future__ import annotations

import json
from datetime import date, datetime
from typing import Any

from attestra.persistence.mongo.serialization import date_to_datetime, ensure_utc


def _parse_dt(value: str) -> datetime | str:
    """Best-effort parse of SQLite/ISO timestamp strings into aware UTC datetimes."""
    text = value.strip()
    if not text:
        return value
    try:
        if text.endswith("Z"):
            text = text[:-1] + "+00:00"
        return ensure_utc(datetime.fromisoformat(text))
    except ValueError:
        return value


def _coerce_value(value: Any) -> Any:
    if isinstance(value, datetime):
        return ensure_utc(value)
    if isinstance(value, date):
        return date_to_datetime(value)
    if isinstance(value, (bytes, bytearray)):
        return value
    if isinstance(value, str):
        # Likely ISO timestamps from SQLite DateTime columns
        looks_iso = len(value) >= 19 and value[4] == "-" and (value[10:11] in ("T", " "))
        if looks_iso:
            normalized = value.replace(" ", "T", 1) if value[10:11] == " " else value
            return _parse_dt(normalized)
        return value
    return value


def row_to_document(table: str, row: dict[str, Any]) -> dict[str, Any]:
    """Map a SQL row dict to a Mongo document with integer ``_id``."""
    data = {k: _coerce_value(v) for k, v in row.items()}
    if table == "tenant_credit_accounts":
        tid = int(data.pop("tenant_id"))
        data["_id"] = tid
        return data
    if "id" not in data:
        raise KeyError(f"table {table} row missing id: keys={sorted(data)}")
    doc_id = int(data.pop("id"))
    data["_id"] = doc_id
    # Decode JSON text fields commonly stored as Text in SQL
    for key in ("checks_json", "notes_json", "details"):
        if key in data and isinstance(data[key], str) and data[key]:
            try:
                data[key] = json.loads(data[key])
            except json.JSONDecodeError:
                pass
    if table == "audit_events" and "ts" in data and "ts_iso" not in data:
        ts = data["ts"]
        if isinstance(ts, datetime):
            data["ts_iso"] = ensure_utc(ts).isoformat()
        elif isinstance(ts, str):
            data["ts_iso"] = ts
    return data


def pk_of(table: str, doc: dict[str, Any]) -> int:
    return int(doc["_id"])
